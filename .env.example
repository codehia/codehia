# Cross-app URLs for the subdomain split. Must include the https:// scheme in
# prod/preview — a bare host is treated as a relative path and breaks links.
# Leave unset for local dev; each app falls back to its localhost port
# (main 4321, blog 4322, projects 4323, notes 4324). Set real values per
# environment via Cloudflare Pages env vars (Production vs Preview scopes).
PUBLIC_URL_MAIN=
PUBLIC_URL_BLOG=
PUBLIC_URL_PROJECTS=
PUBLIC_URL_NOTES=

# CF Pages build only (not local dev): fine-grained, read-only PAT on the private
# vault repo, used by the build step to clone content. Never commit a real value.
# VAULT_PAT=
