---
import { name, themeColor } from 'spectre:globals';
import Layout from '@codehia/ui/Layout.astro';
import { siteUrls } from '@codehia/ui/site-urls';

const navLinks = [
	{ label: 'Blog', href: '/', active: true },
	{ label: 'Projects', href: siteUrls.projects },
	{ label: 'Notes', href: siteUrls.notes },
];

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata;
	pagefindIgnore?: boolean;
	article?: {
		createdAt: Date;
		updatedAt?: Date;
	};
}
---

<Layout
	{...Astro.props}
	name={name}
	themeColor={themeColor}
	siteTitleHref={siteUrls.main}
	navLinks={navLinks}
>
	<slot name="left" slot="left" />
	<slot name="right" slot="right" />
	<slot name="404" slot="404" />
</Layout>
