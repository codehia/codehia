---
import '@codehia/ui/styles/article.css';

import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import ArticleBody from '@codehia/ui/ArticleBody.astro';
import ArticleSidebar from '@codehia/ui/ArticleSidebar.astro';
import { type Series, seriesFor, timeToRead } from '@codehia/ui/article';
import type { GetStaticPaths } from 'astro';
import Layout from '../layouts/Layout.astro';

interface Props {
	post: CollectionEntry<'posts'>;
	series?: Series;
}

const { post, series } = Astro.props;

export const getStaticPaths = (async () => {
	const allPosts = await getCollection('posts', (post) => post.data.draft !== true);

	return allPosts.map((post) => ({
		params: { post: post.id },
		props: { post, series: seriesFor(allPosts, post) },
	}));
}) satisfies GetStaticPaths;

const { Content, headings } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  ogCard={`/og/${post.id}.png`}
  article={{
    createdAt: post.data.createdAt,
    updatedAt: post.data.updatedAt,
  }}
>
  <ArticleSidebar slot="left" title={post.data.title} headings={headings} series={series} />
  <ArticleBody
    slot="right"
    title={post.data.title}
    image={post.data.image}
    ogCard={`/og/${post.id}.png`}
    date={post.data.createdAt}
    readingTime={timeToRead(post.body)}
    tags={post.data.tags.map((tag) => tag.id)}
    backLabel="blog"
  >
    <Content />
  </ArticleBody>
</Layout>
<script>import '@codehia/ui/scripts/toc';</script>
