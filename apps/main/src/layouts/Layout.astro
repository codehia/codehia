---
import { name, themeColor } from 'spectre:globals';
import Layout from '@codehia/ui/Layout.astro';
import { siteUrls } from '@codehia/ui/site-urls';

// Main is the hub: cross-links to every app (none active — its own pages sit at
// root) and merges the subdomain Pagefind indexes into one search.
const navLinks = [
	{ label: 'Blog', href: siteUrls.blog },
	{ label: 'Projects', href: siteUrls.projects },
	{ label: 'Notes', href: siteUrls.notes },
];

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata;
	pagefindIgnore?: boolean;
	article?: {
		createdAt: Date;
		updatedAt?: Date;
	};
}
---

<Layout
	{...Astro.props}
	name={name}
	themeColor={themeColor}
	siteTitleHref="/"
	navLinks={navLinks}
	searchOrigins={[siteUrls.blog, siteUrls.projects, siteUrls.notes]}
>
	<slot name="left" slot="left" />
	<slot name="right" slot="right" />
	<slot name="404" slot="404" />
</Layout>
