---
import '../styles/article.css';

import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Card from '@codehia/ui/Card.astro';
import ImageGlow from '@codehia/ui/ImageGlow.astro';
import type { GetStaticPaths } from 'astro';
import Layout from '../layouts/Layout.astro';

/**
 * Estimates the time it takes to read a note in minutes based on:
 * - A reading speed of 200 words per minute
 * - 10 seconds per image
 * - 20 seconds per code block
 *
 * @param note The note to estimate the reading time for
 */
function timeToRead(note: CollectionEntry<'notes'>): number {
	const numWords = (note.body || '')
		.replace(/.*\[(.*?)\].*/gm, '$1')
		.replace(/```.*?```/gms, '')
		.split(/\s+/).length;

	const numImages = note.body?.match(/!\[/g)?.length || 0;
	const numCodeblocks = note.body?.match(/```/g)?.length || 0;

	return Math.ceil(numWords / 200) + Math.ceil(numImages / 6) + Math.ceil(numCodeblocks / 3);
}

interface Props {
	note: CollectionEntry<'notes'>;
	seriesNotes: CollectionEntry<'notes'>[];
}

const { note, seriesNotes } = Astro.props;

export const getStaticPaths = (async () => {
	const allNotes = await getCollection('notes', (note) => note.data.draft !== true);

	return allNotes.map((note) => {
		const seriesNotes = note.data.series
			? allNotes
					.filter((n) => n.data.series === note.data.series)
					.sort((a, b) => (a.data.seriesPart ?? 0) - (b.data.seriesPart ?? 0))
			: [];
		return { params: { note: note.id }, props: { note, seriesNotes } };
	});
}) satisfies GetStaticPaths;

const { Content, headings } = await render(note);
---

<Layout
  title={note.data.title}
  description={note.data.description}
  image={note.data.image}
  article={{
    createdAt: note.data.createdAt,
    updatedAt: note.data.updatedAt,
  }}
>
  <div class="left" slot="left">
    {seriesNotes.length > 0 && (
      <Card class="series-card">
        <h2 class="no-mt">Series: {note.data.series}</h2>
        <ol class="series-list">
          {seriesNotes.map((n) => (
            <li class="series-li" data-current={n.id === note.id ? 'true' : undefined}>
              {n.id === note.id
                ? <span class="series-current">{n.data.title}</span>
                : <a href={`/${n.id}`}>{n.data.title}</a>
              }
            </li>
          ))}
        </ol>
      </Card>
    )}
    <Card class="toc-card">
      <h2 class="no-mt">Table of contents</h2>
      <ol>
        <li class="toc-li">
          <a href={`#_top`} class="active">{note.data.title}</a>
        </li>
        {headings.map((heading, i) => (
          <li class="toc-li" data-depth={heading.depth}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </Card>
  </div>
  <article slot="right" data-pagefind-body>
    <Card>
      <div class="article-header" id="_top" data-pagefind-ignore>
        <ImageGlow quality={100} class="article-image" src={note.data.image} alt={note.data.title} />
        <div class="header">
          <div>
            <h1 class="no-mt article-h1">{note.data.title}</h1>
          </div>
          <div class="article-info">
            <span>{note.data.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            <span>/</span>
            <span>{timeToRead(note)} minute{timeToRead(note) === 1 ? "" : "s"} to read</span>
            <span>/</span>
            <span>Tags: {note.data.tags.join(", ")}</span>
          </div>
        </div>
      </div>
      <Content />
      <hr class="end-of-article" />
      <a href="/" class="block-link" data-pagefind-ignore>← Back to notes</a>
    </Card>
  </article>
</Layout>
<script src="../scripts/toc.ts" />
<style is:global>
  .toc-card ol {
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: .5rem;
    margin-bottom: 0;
    list-style-type: none;
    position: relative;
  }

  .toc-card ol li a {
    color: #c7c7c7;
    font-size: .925rem;
    padding: .25rem .5rem;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .toc-card ol li a:hover {
    color: white;
    text-decoration: none;
  }

  .toc-card ol li a.active {
    color: white;
    background: var(--primary);
  }

  .left {
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .toc-card {
    position: sticky;
    top: 2rem;
  }

  .series-card {
    position: sticky;
    top: 2rem;
  }

  .series-list {
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: .5rem;
    margin-bottom: 0;
    list-style-type: none;
    counter-reset: series-counter;
  }

  .series-li {
    counter-increment: series-counter;
    font-size: .925rem;
    padding: .25rem .5rem;
    display: flex;
    align-items: baseline;
    gap: .5rem;
  }

  .series-li::before {
    content: counter(series-counter) ".";
    color: var(--primary);
    font-size: .8rem;
    flex-shrink: 0;
  }

  .series-li a {
    color: #c7c7c7;
  }

  .series-li a:hover {
    color: white;
    text-decoration: none;
  }

  .series-current {
    color: white;
    background: var(--primary);
    padding: .25rem .5rem;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .comments * {
    border-color: #353535 !important;
  }

  @media screen and (max-width: 640px) {
    article {
      gap: 1rem;
    }
  }

</style>
