---
import '@codehia/ui/styles/article.css';

import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import ArticleBody from '@codehia/ui/ArticleBody.astro';
import ArticleSidebar from '@codehia/ui/ArticleSidebar.astro';
import { type Series, seriesFor, timeToRead } from '@codehia/ui/article';
import type { GetStaticPaths } from 'astro';
import Layout from '../layouts/Layout.astro';

interface Props {
	note: CollectionEntry<'notes'>;
	series?: Series;
}

const { note, series } = Astro.props;

export const getStaticPaths = (async () => {
	const allNotes = await getCollection('notes', (note) => note.data.draft !== true);

	return allNotes.map((note) => ({
		params: { note: note.id },
		props: { note, series: seriesFor(allNotes, note) },
	}));
}) satisfies GetStaticPaths;

const { Content, headings } = await render(note);
---

<Layout
  title={note.data.title}
  description={note.data.description}
  image={note.data.image}
  ogCard={`/og/${note.id}.png`}
  article={{
    createdAt: note.data.createdAt,
    updatedAt: note.data.updatedAt,
  }}
>
  <ArticleSidebar slot="left" title={note.data.title} headings={headings} series={series} />
  <ArticleBody
    slot="right"
    title={note.data.title}
    image={note.data.image}
    ogCard={`/og/${note.id}.png`}
    date={note.data.createdAt}
    readingTime={timeToRead(note.body)}
    tags={note.data.tags}
    backLabel="notes"
  >
    <Content />
  </ArticleBody>
</Layout>
<script>import '@codehia/ui/scripts/toc';</script>
