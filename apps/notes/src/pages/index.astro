---
import '@codehia/ui/styles/article-list.css';

import { getCollection } from 'astro:content';
import { openGraph } from 'spectre:globals';
import Card from '@codehia/ui/Card.astro';
import Icon from '@codehia/ui/Icon.astro';
import Layout from '../layouts/Layout.astro';

const notes = await getCollection('notes', (note) => note.data.draft !== true);
const tags = notes.flatMap((note) => note.data.tags ?? []);

// Notes are organized by their top vault folder: `notes/<section>/<slug>.md`.
// The top folder becomes a section heading on this page. Notes that sit at the
// vault root (no folder) fall under "General".
const sections = new Map<string, typeof notes>();
for (const note of notes) {
	const slash = note.id.indexOf('/');
	const section = slash === -1 ? 'General' : note.id.slice(0, slash);
	if (!sections.has(section)) sections.set(section, []);
	sections.get(section)?.push(note);
}
const sortedSections = Array.from(sections.entries()).sort(([a], [b]) => a.localeCompare(b));
---

<Layout
  title={openGraph.notes?.title || "Notes"}
  description={openGraph.notes?.description}
>
  <div class="layout-grid-left" slot="left">
    <Card class="flex-col-card">
      <h2 class="no-mt">Filter</h2>
      <ul class="tags-list">
        {Array.from(new Set(tags)).map((tag) => (
          <li>
            <a
              class="blog-tag"
              href="/"
              data-tag={tag}
            >
              {tag}
            </a>
          </li>
        ))}
      </ul>
    </Card>
  </div>
  <div class="layout-grid-right" slot="right">
    <Card>
      <div class="header-container" data-pagefind-body>
        <Icon type="lucide" name="notebook-pen" width={24} height={24} class='glow-icon' />
        <h2>Latest Notes</h2>
      </div>
      <div class="content-container">
        {notes.length === 0 && (
          <p>No notes published yet.</p>
        )}
        {sortedSections.map(([section, sectionNotes]) => (
          <section class="notes-section">
            <h3 class="notes-section-heading">{section}</h3>
            {sectionNotes
              .sort((a, b) => (b.data.createdAt?.getTime() ?? 0) - (a.data.createdAt?.getTime() ?? 0))
              .map((note) => (
                <a href={`/${note.id}`} class="post-container" data-tags={(note.data.tags ?? []).join(",")}>
                  <div class="post-header">
                    <h3>{note.data.title}</h3>
                    {note.data.createdAt && (
                      <span class="post-date">{note.data.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                    )}
                  </div>
                  <span>{note.data.description}</span>
                </a>
              ))}
          </section>
        ))}
      </div>
    </Card>
  </div>
</Layout>
<script>import '@codehia/ui/scripts/tag-filter';</script>
<style>
  .notes-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .notes-section-heading {
    margin-bottom: 0;
    color: var(--primary);
  }
</style>
