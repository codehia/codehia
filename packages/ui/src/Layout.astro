---
import './styles/reset.css';
import './styles/globals.css';

import Background from './Background.astro';
import LayoutGrid from './LayoutGrid.astro';
import Navbar from './Navbar.astro';

interface NavLink {
	label: string;
	href: string;
	active?: boolean;
}

interface Props {
	// Page
	title: string;
	description?: string;
	image?: ImageMetadata;
	/** Generated title card (`/og/<slug>.png`), used when there is no `image`. */
	ogCard?: string;
	pagefindIgnore?: boolean;
	article?: {
		createdAt: Date;
		updatedAt?: Date;
	};
	// Spectre globals — passed as props so this package stays free of the
	// `spectre:globals` virtual module (same reason Navbar takes `name`).
	name: string;
	themeColor: string;
	// Nav
	siteTitleHref: string;
	navLinks: NavLink[];
	searchOrigins?: string[];
}

const {
	title,
	description,
	image,
	ogCard,
	pagefindIgnore,
	article,
	name,
	themeColor,
	siteTitleHref,
	navLinks,
	searchOrigins = [],
} = Astro.props;

// og:image must be an absolute URL — a relative path is not resolvable by most
// scrapers. Frontmatter image first, then the generated title card, then the
// site-wide default for pages that are neither (home, about, 404).
const ogImage = new URL(image?.src ?? ogCard ?? '/img/og-default.png', Astro.site);
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<link rel="preload" href="/fonts/Geist.woff2" as="font" type="font/woff2" crossorigin="">
		<link rel="preload" href="/fonts/GeistMono.woff2" as="font" type="font/woff2" crossorigin="">

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<meta name="theme-color" content={themeColor}>

		<link rel="canonical" href={Astro.url} />

		<meta name="og:title" content={title} />
		{description && <meta name="og:description" content={description} />}
		<meta name="og:image" content={ogImage} />
		<meta name="og:url" content={Astro.site} />
		{!article && <meta name="og:type" content="website" />}
		<meta name="og:locale" content="en" />

		{article && (
			<meta name="og:type" content="article" />
			<meta property="article:published_time" content={article.createdAt.toISOString()} />
			<meta name="author" content={name} />
		)}

		{article && article.updatedAt && (
			<meta property="article:modified_time" content={article.updatedAt.toISOString()} />
		)}

	</head>
	<body>
		<main data-pagefind-ignore={pagefindIgnore}>
			<Navbar name={name} siteTitleHref={siteTitleHref} links={navLinks} searchOrigins={searchOrigins} />
			<LayoutGrid>
				<slot name="left" slot="left" />
				<slot name="right" slot="right" />
			</LayoutGrid>
			<slot name="404" />
		</main>
		<Background />
	</body>
</html>
