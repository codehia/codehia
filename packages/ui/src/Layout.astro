---
import './styles/reset.css';
import './styles/globals.css';

// Shared static assets, bundled by Vite into each app's hashed `/_astro/` output
// (one copy here instead of one per app's `public/`). `no-inline` keeps the
// small favicon a real file rather than a data URI repeated in every page.
import ogDefaultUrl from '../og-background.png?url';
import Background from './Background.astro';
import faviconUrl from './favicon.svg?url&no-inline';
import geistUrl from './fonts/Geist.woff2?url';
import geistMonoUrl from './fonts/GeistMono.woff2?url';
import LayoutGrid from './LayoutGrid.astro';
import Navbar from './Navbar.astro';
import type { NavLink, PageProps } from './types';

interface Props extends PageProps {
	// Spectre globals — passed as props so this package stays free of the
	// `spectre:globals` virtual module (same reason Navbar takes `name`).
	name: string;
	themeColor: string;
	// Nav
	siteTitleHref: string;
	navLinks: NavLink[];
	searchOrigins?: string[];
}

const {
	title,
	description,
	image,
	ogCard,
	pagefindIgnore,
	article,
	name,
	themeColor,
	siteTitleHref,
	navLinks,
	searchOrigins = [],
} = Astro.props;

// og:image must be an absolute URL — a relative path is not resolvable by most
// scrapers. Frontmatter image first, then the generated title card, then the
// site-wide default for pages that are neither (home, about, 404).
const ogImage = new URL(image?.src ?? ogCard ?? ogDefaultUrl, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin="">
		<link rel="preload" href={geistMonoUrl} as="font" type="font/woff2" crossorigin="">

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={faviconUrl} />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<meta name="theme-color" content={themeColor}>

		<link rel="canonical" href={Astro.url} />

		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:image" content={ogImage} />
		<meta property="og:url" content={Astro.url} />
		{!article && <meta property="og:type" content="website" />}
		<meta property="og:locale" content="en" />

		{article && (
			<meta property="og:type" content="article" />
			<meta property="article:published_time" content={article.createdAt.toISOString()} />
			<meta name="author" content={name} />
		)}

		{article && article.updatedAt && (
			<meta property="article:modified_time" content={article.updatedAt.toISOString()} />
		)}

	</head>
	<body>
		<main data-pagefind-ignore={pagefindIgnore}>
			<Navbar name={name} siteTitleHref={siteTitleHref} links={navLinks} searchOrigins={searchOrigins} />
			<LayoutGrid>
				<slot name="left" slot="left" />
				<slot name="right" slot="right" />
			</LayoutGrid>
			<slot name="404" />
		</main>
		<Background />
	</body>
</html>
